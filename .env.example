# Скопируй этот файл в .env и подставь СВОИ данные (.env в git не попадает).
# Здесь не должно быть ничьих личных значений: ни почты, ни имени, ни путей
# с чужим именем пользователя. Свежая установка не должна наследовать чужую
# личность. Проверка настроек: python scripts/acl_doctor.py
JIRA_EMAIL=you@adopy.com
JIRA_API_TOKEN=твой_токен_из_Jira

# ── Stats Excel ───────────────────────────────────────────────────────────────
# Путь к отчёту (cursor example.xlsx). По умолчанию — «cursor example.xlsx» на
# рабочем столе ТЕКУЩЕГО пользователя, так что задавать нужно, только если файл
# лежит в другом месте. Переменные вида %USERPROFILE% здесь НЕ раскрываются —
# пишите полный путь.
# FB_STATS_EXCEL=

# ── Agent 9: Meta campaign publish ───────────────────────────────────────────
# System User token with ads_management on your ad accounts
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0
# Facebook Page ID for ad creatives (or set page_id per row in ad_account_map.csv / Link Object ID in Excel)
META_PAGE_ID=
# Корневая папка креативов (рекурсивный поиск по имени файла из Excel).
# По умолчанию — папка Creatives на рабочем столе текущего пользователя.
# FB_CREATIVES_ROOT=
# CSV: account_name,ad_account_id — скопируй из config/ad_account_map.example.csv
# META_AD_ACCOUNT_MAP_PATH=config/ad_account_map.csv
# Upluad FB.xlsx для Interests JSON и Ad copy.
# По умолчанию — на рабочем столе текущего пользователя.
# UPLOAD_FB_EXCEL=

# ── RPA browser (no MLX automation token required for multilogin_direct) ────────
# multilogin_direct = Mimic profile via CDP (default when token empty)
# playwright_profile = vanilla Chromium + MLX cookies
# multilogin = MLX Launcher API (needs MULTILOGIN_AUTOMATION_TOKEN_A)
# FB_BROWSER_PROVIDER=multilogin_direct
MULTILOGIN_AUTOMATION_TOKEN_A=
MULTILOGIN_LAUNCHER_BASE_A=https://launcher.mlx.yt:45001/api/v2
MULTILOGIN_AUTOMATION_TOKEN_B=
MULTILOGIN_LAUNCHER_BASE_B=https://launcher.mlx.yt:45001/api/v2

# ── RPA engine: live LLM agent (Option B) vs static recipe player ───────────────
# llm_agent = Claude looks at the accessibility tree and decides each click live
#             (get a key at https://console.anthropic.com — separate billing
#             from any Claude Code subscription). Unset/empty = static recipe
#             player (config/rpa_recipes/campaign_golden.yaml), no API cost.
# Движок RPA. recorded_flow — единственный, на котором проверены полные
# прогоны (метка rpa-v96-spend-confirmed-2026-08-24). Пустое значение
# отдаёт управление recipe player, у которого включается стоп-гейт и
# кампания собирается наполовину.
FB_RPA_ENGINE=recorded_flow
ANTHROPIC_API_KEY=
# Optional override, default claude-sonnet-4-5
FB_RPA_LLM_MODEL=

# ── Morning Report ────────────────────────────────────────────────────────────
# Ваше имя в колонке CM статистики — ровно как оно там написано.
# По нему дешборд решает, чьи аккаунты и оптимизацию показывать.
MY_CM_NAME=
# Google Sheet с ежедневными аккаунтами (последний таб = сегодня)
# ID из URL: docs.google.com/spreadsheets/d/<ID>/edit
GSHEET_ACCOUNTS_ID=your_accounts_sheet_id_here
# "auto_last" = всегда брать самый правый таб (рекомендуется)
GSHEET_ACCOUNTS_SHEET=auto_last

# ── Google Credentials (общий ключ для всех GSheet интеграций) ────────────────
# Для новых установок OAuth client хранится в %LOCALAPPDATA%\ACL\oauth_client.json,
# а token_accounts.json создаётся рядом после первого браузерного входа.
# Эти overrides нужны только для нестандартного расположения.
# GSHEET_OAUTH_CLIENT=
# GSHEET_OAUTH_TOKEN=
# Путь к JSON-ключу сервисного аккаунта Google (относительно корня проекта)
GOOGLE_CREDENTIALS_JSON=config/google_credentials.json

# ── Knowledge Base: Google Sheets (targets) ───────────────────────────────────
# ID таблицы из URL: docs.google.com/spreadsheets/d/<GSHEET_TARGETS_ID>/
GSHEET_TARGETS_ID=1WlSGohkev4h_n0gw2vl0jlJEDFpTGl306fF7bIiRt9k
# Имя листа (Sheet tab name) ИЛИ оставь пустым — используется --gid для авто-резольва
GSHEET_TARGETS_SHEET=
# Числовой GID листа из URL (#gid=...). Используется если GSHEET_TARGETS_SHEET не задан
GSHEET_TARGETS_GID=1404476956

# ── Knowledge Base: Офферы ────────────────────────────────────────────────────
# Путь к отдельному Excel-файлу со списком офферов и LP-ссылками
OFFERS_EXCEL=path/to/offers.xlsx
# Названия колонок в этом Excel (если не указать — скрипт спросит интерактивно)
OFFERS_COL_NAME=Offer
OFFERS_COL_URL=LP URL

# ── Knowledge Base: Context Packs ──────────────────────────────────────────────
# Local SQLite DB for structured context-pack lookup
KB_CONTEXT_DB=data/knowledge_context.db
# Markdown exports for human-readable context packs
KB_CONTEXT_OUTPUT_DIR=output/context_packs

# ── Content Machine (Telegram publishing) ─────────────────────────────────────
# Telegram Bot API token (create via @BotFather)
TG_BOT_TOKEN=your_bot_token_here
# Chat ID for private draft review (your personal chat with the bot)
TG_REVIEW_CHAT_ID=your_review_chat_id
# Chat ID for the public channel/group where posts are published
TG_PUBLISH_CHAT_ID=your_channel_chat_id
# OpenAI key for LLM agents (content generation, compliance checks)
OPENAI_API_KEY=your_openai_key_here
CM_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
# LLM model (default: gpt-4o)
CM_LLM_MODEL=gemini-2.5-flash
# Shadow mode: agents draft but don't auto-publish (1=on, 0=off)
CM_SHADOW_MODE=1
# Language for generated post text, disclosures, and bot UI: es (Spanish), en, ru
CM_CONTENT_LANG=es
# Timezone for scheduled posts
CM_TIMEZONE=Europe/Moscow
# SQLite database path (default: data/content_machine.db)
# CM_DB_PATH=data/content_machine.db
#
# Недельный стратегический ввод для `python run_content_machine.py plan` (опционально)
# CM_WEEK_PLAN_PATH=config/my_week_strategy.json
# CM_WEEK_PLAN_JSON={"weekly_goals":["..."],"exclude_dates":[],"notes":""}

# ── Agent 10: Facebook Ads Manager publish (Playwright) ───────────────────────
# Путь к сохранённой сессии браузера. Создаётся один раз: python run_fb_login_session.py
FB_ADS_AUTH_STATE=.auth/fb_state.json
# URL Ads Manager (обычно не нужно менять)
FB_ADS_MANAGER_URL=https://adsmanager.facebook.com/adsmanager/manage/campaigns
# Папка для скриншотов/trace/отчётов по прогонам
FB_PUBLISH_OUTPUT_DIR=output/fb_publish_runs

# ── ACL: общая телеметрия прогонов (необязательно) ───────────────────────────
# Зачем: одна смена интерфейса Meta ломает шаги у всех сразу. Когда машины
# складывают телеметрию в одну таблицу, это видно за час — резкий скачок
# провалов одного шага у всех в один день. Без этого каждый диагностирует сам,
# как 24.08: четыре поломки, целый день поиска по одной.
#
# Отправка идёт ОТДЕЛЬНОЙ командой, не во время прогона:
#   python scripts/acl_telemetry_upload.py
#
# Доступ — пользовательский OAuth: машина пишет в таблицу от имени того, кто за
# ней работает. Одно браузерное согласие при установке, дальше молча.
#
# Два «безлюдных» способа закрыты политикой Workspace в Adopy и здесь НЕ
# работают, не тратьте на них время:
#   сервисный аккаунт     — расшарить на него таблицу нельзя, домен вне белого
#                           списка («not a Google Account in a compatible
#                           allowlisted domain»)
#   веб-приложение Apps Script — уровня доступа «Все» нет в списке, только
#                           «Только я» и «Все в Adopy», а машина обращается
#                           анонимно
# Оба оставлены в коде и подхватятся сами, если политика изменится.
#
# Что нужно задать: только идентификатор таблицы. Она должна быть расшарена
# на компанию — тогда писать в неё вправе любой сотрудник.
# GSHEET_TELEMETRY_ID=
# GSHEET_TELEMETRY_SHEET=rpa_telemetry
#
# Токен записи создаётся при первом запуске выгрузки и лежит в машинной папке
# (%LOCALAPPDATA%\ACL\token_telemetry.json). Токен дешборда, умеющий только
# чтение, при этом не затрагивается.
#
# Понятное имя машины в отчётах (по умолчанию — имя компьютера):
# ACL_MACHINE_LABEL=
