# IDE
.idea/
.vscode/
*.swp
*~

# Secrets (never commit)
.env
config/google_credentials.json
config/oauth_client.json
config/token_accounts.json
# Per-machine, not code: every media buyer running ACL has a different
# account map, and the work repo is readable by outside developers.
# Lives in %LOCALAPPDATA%\ACL (see config/paths.get_local_config_dir);
# copy config/ad_account_map.example.csv to start one.
config/ad_account_map.csv

# Agent 10: сохранённая сессия браузера FB Ads Manager + прогоны (скриншоты/trace)
.auth/

# Архив статистики для дневника креативов (накапливается локально, крупный)
data/*.sqlite3

# Obsidian
.obsidian/

# OpenStation
.openstation/

# Claude Code
.claude/

# Brainstorm visual companion sessions
.superpowers/

# OS
.DS_Store
Thumbs.db

# Excel lock/temp files

# RPA runtime artifacts (regenerated every run — screenshots, evidence packs,
# per-account learned recipe dumps, job/test logs)
# Per-run RPA telemetry (local diagnostic data, grows every run)
serve_out.log
serve_err.log
serve_recipe_player.log
_diag_out/
analysis_agent/debug-*.log

# Local SQLite (recreated at runtime)
data/*.db
data/*.db-shm
data/*.db-wal

# impeccable-ignore-start
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# ACL machine-local state (never code): service-account key, machine id,
# telemetry cursor. These live in %LOCALAPPDATA%\ACL, but ignore them here
# too in case someone points ACL_CONFIG_DIR inside the checkout.
telemetry_service_account.json
machine_id.txt
telemetry_cursor.json
token_telemetry.json

# ── output/ ──────────────────────────────────────────────────────────────────
# Всё содержимое — следы прогонов: скриншоты, дампы, планы, логи. Раньше здесь
# был список частных правил, и 13 файлов всё равно оказались под гитом: они
# переписывались каждым прогоном, поэтому признак «есть локальные правки» в
# строке версии потока приходилось сужать вручную, чтобы он не горел всегда.
#
# Проверено 31.08: ни на один из них не ссылается ни код, ни тесты. То, что
# выглядело ссылками, оказалось путями ЗАПИСИ (unknown_targets.log,
# upload_plan.xlsx), а тест контекст-пака создаёт свой файл во временной папке.
output/*
!output/.gitkeep

# Pinned shared tracker runtime cache
.tracker-runtime/
__pycache__/
